// Socle. Les fonctionnalités actives y ajoutent leurs fragments.
// Généré vers prisma/schema/base.prisma par `pnpm build:registry`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Setting {
  key   String @id
  value String
}
