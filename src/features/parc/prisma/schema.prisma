/// Fiche d'une flotte : ce qu'on cherche quand un client appelle. Le tag
/// Headscale reste l'identifiant technique ; `displayName` n'est qu'un libellé.
model FleetProfile {
  tag         String   @id
  displayName String?
  sector      String?
  contact     String?
  phone       String?
  email       String?
  site        String?
  reference   String?
  notes       String?
  updatedAt   DateTime @updatedAt
}

/// Catalogue des produits Stramatel (modifiable depuis l'interface). `role`
/// « master » pose le tag MASTER sur la machine qui porte ce produit.
model Product {
  id        Int              @id @default(autoincrement())
  name      String           @unique
  /// 'gamme' | 'sur-mesure'
  category  String           @default("gamme")
  /// Obsolète (remplacé par `slaves`), conservé pour ne pas perdre de colonne.
  role      String?
  /// Machine maîtresse (tag MASTER) : SL TEMPO, serveur SL MEDIA.
  master    Boolean          @default(false)
  /// Accepte des SLAVE rattachés (SL MEDIA) : la machine est alors maîtresse ou SLAVE.
  slaves    Boolean          @default(false)
  createdAt DateTime         @default(now())
  machines  MachineProduct[]
  slots     FleetSlot[]
  linksFrom ProductLink[]    @relation("LinkFrom")
  linksTo   ProductLink[]    @relation("LinkTo")
  assessments VulnAssessment[]
}

/// Tri d'une faille (VEX) : « non concerné », « en analyse » ou « concerné »,
/// pour tout le parc ou pour un produit, avec sa justification. Une faille
/// « non concernée » sort des décomptes (tableau de bord, cybersécurité).
model VulnAssessment {
  id            Int      @id @default(autoincrement())
  /// CVE, ou identifiant OSV sans CVE : une seule décision pour Debian et Ubuntu.
  vulnKey       String
  /// Produit visé ; null = tout le parc.
  productId     Int?
  product       Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// 'not_affected' | 'under_investigation' | 'affected'
  status        String
  /// Justification VEX d'un « non concerné » : component_not_present,
  /// vulnerable_code_not_present, vulnerable_code_not_in_execute_path,
  /// vulnerable_code_cannot_be_controlled_by_adversary, inline_mitigations_already_exist.
  justification String?
  note          String?
  author        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([vulnKey])
}

/// Flux entre produits : « SL TEMPO joint SL MEDIA sur tel port ». Un lien
/// d'un produit vers lui-même relie les SLAVE à leur serveur.
model ProductLink {
  id        Int      @id @default(autoincrement())
  fromId    Int
  from      Product  @relation("LinkFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId      Int
  to        Product  @relation("LinkTo", fields: [toId], references: [id], onDelete: Cascade)
  /// Ports ou plages, séparés par des virgules ; « * » pour tous.
  ports     String   @default("*")
  note      String?
  createdAt DateTime @default(now())

  @@unique([fromId, toId])
}

/// Produit installé sur une machine (identifiée par son nœud Headscale).
model MachineProduct {
  nodeId    String   @id
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  /// N° d'affaire, pour un produit sur mesure.
  reference String?
  /// Pour un SLAVE : le serveur (nœud) auquel il est rattaché.
  masterNodeId String?
  updatedAt DateTime @updatedAt
}

/// Emplacement prévu dans une flotte (« préparer une flotte ») : un poste
/// d'hypervision, ou un équipement d'un produit donné. Pourvu par une clé
/// émise pour lui, ou par une machine en attente qu'on y affecte.
model FleetSlot {
  id          Int       @id @default(autoincrement())
  fleetTag    String
  /// 'equipment' | 'hypervision'
  kind        String    @default("equipment")
  productId   Int?
  product     Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  label       String
  reference   String?
  position    Int       @default(0)
  nodeId      String?
  keyId       String?
  keyIssuedAt DateTime?
  /// SLAVE : emplacement du serveur auquel il est rattaché.
  parentSlotId Int?
  parent       FleetSlot?  @relation("SlotSlaves", fields: [parentSlotId], references: [id], onDelete: Cascade)
  slaves       FleetSlot[] @relation("SlotSlaves")
  createdAt   DateTime  @default(now())

  @@index([fleetTag])
}

/// Modèle de flotte réutilisable : liste d'emplacements types.
/// items : [{ kind, productId, count, label, slaves }]
model FleetTemplate {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  items       String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
