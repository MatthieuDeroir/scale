# Généré par : pnpm secret:generate
JWT_SECRET=

DATABASE_URL="file:../data/app.db"

PORT=3000
BIND_ADDRESS=0.0.0.0

# Origines autorisées en production, séparées par des virgules.
# Vide = même origine uniquement.
CORS_ORIGINS=

# transport-serial désactivé (pas de matériel dans ce projet) : pas de SERIAL_PATH/SERIAL_BAUD_RATE.

# API Headscale (fork Stramscale). La clé n'est lue que côté serveur
# (src/app/api/fleets/), jamais exposée au navigateur.
# En local : dev-local/docker-compose.yml expose Headscale sur :8080 ;
# générer la clé avec `headscale apikeys create --expiration 90d` dans le
# conteneur, voir dev-local/.
HEADSCALE_API_URL=http://localhost:8080
HEADSCALE_API_KEY=

# Utilisateur Headscale propriétaire de toutes les clés (vérifié sur
# dev-local : un seul utilisateur, `stramatel` — une clé = une machine
# taguée, pas un utilisateur Headscale par client).
HEADSCALE_USER=stramatel

# Adresse Headscale telle que la voit une machine à enrôler (≠ HEADSCALE_API_URL,
# vue depuis ce serveur). Affichée dans la commande d'installation d'un poste
# d'hypervision. En local : http://headscale:8080 (réseau docker de dev-local).
HEADSCALE_PUBLIC_URL=

# Domaine DNS du VPN (dns.base_domain de Headscale) : chaque machine y est
# joignable par son nom, ex. quai-2-gare-nord.stramscale.internal. Vide = pas
# de nom affiché.
HEADSCALE_BASE_DOMAIN=

# Secret de fabrication embarqué dans l'image dorée des machines internes
# (NUC/RPi) — authentifie POST /api/provisioning/enroll, endpoint public
# appelé par une machine qui vient de démarrer et n'a pas de session.
# Même valeur sur tous les clones d'une génération d'image ; à faire tourner
# à chaque nouvelle génération.
PROVISIONING_SECRET=

# Redémarrage quotidien, heure locale Europe/Paris. Vide = désactivé.
REBOOT_AT=

# Langue de livraison de l’équipement (fr par défaut).
APP_LOCALE=fr
