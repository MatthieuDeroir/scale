{
  "name": "stramscale-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "next build && node scripts/build-server.mjs",
    "build:registry": "tsx scripts/build-registry.ts",
    "db:generate": "pnpm build:registry && prisma generate",
    "db:push": "pnpm build:registry && prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "dev": "tsx server/index.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "i18n:check": "tsx scripts/check-translations.ts",
    "lint": "eslint .",
    "prebuild": "pnpm build:registry",
    "predev": "pnpm build:registry",
    "release": "bash scripts/release-docker.sh",
    "release:offline": "bash scripts/release-docker.sh --offline",
    "secret:generate": "node scripts/generate-secret.mjs",
    "start": "NODE_ENV=production node dist/server.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:frames": "vitest run --project frames",
    "test:integration": "vitest run --project integration",
    "test:transport": "vitest run --project transport",
    "test:unit": "vitest run --project unit",
    "typecheck": "tsc --noEmit",
    "update": "bash scripts/update-docker.sh",
    "verify": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.1.1",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-separator": "^1.1.10",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.1",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@tanstack/react-query": "^5.101.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.3",
    "lucide-react": "^1.21.0",
    "next": "16.3.2",
    "next-intl": "^4.13.1",
    "rate-limiter-flexible": "^5.0.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.54.2",
    "serialport": "^12.0.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9.17.0",
    "eslint-config-next": "16.3.2",
    "eslint-plugin-project-structure": "^3.14.3",
    "jsdom": "^26.0.0",
    "prettier": "^3.4.2",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}
